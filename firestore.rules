rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && userExists() &&
        (getUserData().role == 'admin' || getUserData().role == 'staff');
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow read, update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /dsa_registrations/{regId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /banker_registrations/{regId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /partner_registrations/{regId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /loan_applications/{applicationId} {
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.user_id == request.auth.uid);
      allow read: if isAdmin() || (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow update: if isAdmin() || (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /referrals/{referralId} {
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.referrer_id == request.auth.uid);
      allow read: if isAdmin() || (isAuthenticated() && resource.data.referrer_id == request.auth.uid);
      allow update: if isAdmin() || (isAuthenticated() && resource.data.referrer_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /news_feed/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /admin_posts/{postId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /statuses/{statusId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /bank_policies/{policyId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /broadcast_history/{broadcastId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
