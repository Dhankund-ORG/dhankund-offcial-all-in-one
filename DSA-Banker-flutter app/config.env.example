# Dhankund DSA/Banker Flutter app configuration
# Copy this file to config.env and fill in real values. Never commit config.env.
#
#   cp config.env.example config.env

# Firebase web config (used by the web build)
DSA_FIREBASE_WEB={"apiKey":"REPLACE","authDomain":"REPLACE","databaseURL":"REPLACE","projectId":"REPLACE","storageBucket":"REPLACE","messagingSenderId":"REPLACE","appId":"REPLACE","measurementId":"REPLACE"}

# Firebase Android/iOS config (used by mobile builds)
DSA_FIREBASE_ANDROID={"apiKey":"REPLACE","appId":"REPLACE","messagingSenderId":"REPLACE","projectId":"REPLACE"}
DSA_FIREBASE_IOS={"apiKey":"REPLACE","appId":"REPLACE","messagingSenderId":"REPLACE","projectId":"REPLACE"}

# Upload backend base URL (production default)
CLOUDFLARE_API_BASE_URL=https://dhankund.com
